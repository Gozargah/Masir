 )
 
 type SizeStatWriter struct {
@@ -23,3 +29,83 @@
 func (w *SizeStatWriter) Interrupt() {
 	common.Interrupt(w.Writer)
 }
+
+// profileFlowWriter follows the link lifetime even when a mux dispatch has
+// already returned and its worker still owns the live stream.
+type profileFlowWriter struct {
+	buf.Writer
+	release func()
+}
+
+func trackProfileFlow(ctx context.Context, counter stats.Counter, link *transport.Link) {
+	counter.Add(1)
+	finish := sync.OnceFunc(func() { counter.Add(-1) })
+	stop := context.AfterFunc(ctx, finish)
+	var remaining atomic.Int32
+	remaining.Store(2)
+	directionDone := func() {
+		if remaining.Add(-1) == 0 {
+			stop()
+			finish()
+		}
+	}
+	if reader, ok := link.Reader.(*profileTrafficReader); ok {
+		reader.release = sync.OnceFunc(directionDone)
+	} else {
+		link.Reader = &profileTrafficReader{Reader: link.Reader, release: sync.OnceFunc(directionDone)}
+	}
+	link.Writer = &profileFlowWriter{Writer: link.Writer, release: sync.OnceFunc(directionDone)}
+}
+
+// SpliceStatWriter exposes the counter that direct splice writes bypass.
+func (w *profileFlowWriter) SpliceStatWriter() *SizeStatWriter {
+	writer, _ := w.Writer.(*SizeStatWriter)
+	return writer
+}
+
+func (w *profileFlowWriter) Close() error {
+	defer w.release()
+	return common.Close(w.Writer)
+}
+
+func (w *profileFlowWriter) Interrupt() {
+	defer w.release()
+	common.Interrupt(w.Writer)
+}
+
+type profileTrafficReader struct {
+	buf.Reader
+	counter stats.Counter
+	release func()
+}
+
+func (r *profileTrafficReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb, err := r.Reader.ReadMultiBuffer()
+	r.record(mb, err)
+	return mb, err
+}
+
+func (r *profileTrafficReader) ReadMultiBufferTimeout(timeout time.Duration) (buf.MultiBuffer, error) {
+	if reader, ok := r.Reader.(buf.TimeoutReader); ok {
+		mb, err := reader.ReadMultiBufferTimeout(timeout)
+		r.record(mb, err)
+		return mb, err
+	}
+	return nil, buf.ErrReadTimeout
+}
+
+func (r *profileTrafficReader) record(mb buf.MultiBuffer, err error) {
+	if r.counter != nil {
+		r.counter.Add(int64(mb.Len()))
+	}
+	if err != nil && err != buf.ErrReadTimeout && r.release != nil {
+		r.release()
+	}
+}
+
+func (r *profileTrafficReader) Interrupt() {
+	if r.release != nil {
+		defer r.release()
+	}
+	common.Interrupt(r.Reader)
+}
