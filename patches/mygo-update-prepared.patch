+func TestPreparedHookRunsOnlyAfterVerificationAndBeforeReplacement(t *testing.T) {
+	for _, deltaFrom := range []string{"", "1.1.9"} {
+		t.Run("delta-"+deltaFrom, func(t *testing.T) {
+			srv, key, m, _ := updateServer(t, "1.2.0", "v2", deltaFrom)
+			_ = srv
+			target, main := installedApp(t)
+			called := false
+			hook := func(dir string) error {
+				called = true
+				if b, _ := os.ReadFile(main); string(b) != "v1" {
+					t.Fatal("replaced the running app before the hook")
+				}
+				found := false
+				filepath.WalkDir(dir, func(path string, e os.DirEntry, err error) error {
+					if err == nil && !e.IsDir() {
+						if b, _ := os.ReadFile(path); string(b) == "v2" {
+							found = true
+						}
+					}
+					return err
+				})
+				if !found {
+					t.Fatal("hook did not receive the reconstructed app")
+				}
+				return fmt.Errorf("service refused")
+			}
+			err := installUpdatePrepared(context.Background(), httpGet, m, key, "1.1.9", target, nil, hook)
+			if err == nil || !called {
+				t.Fatalf("hook err=%v called=%v", err, called)
+			}
+			if b, _ := os.ReadFile(main); string(b) != "v1" {
+				t.Fatal("failed hook changed the app")
+			}
+			called = false
+			m.Signature = "invalid"
+			for i := range m.Deltas {
+				m.Deltas[i].Signature = "invalid"
+			}
+			err = installUpdatePrepared(context.Background(), httpGet, m, key, "1.1.9", target, nil, hook)
+			if err == nil || called {
+				t.Fatal("unauthenticated payload reached hook")
+			}
+		})
+	}
+}
