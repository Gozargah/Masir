+// A spring-sized popover changes size after each drawn frame. Once the previous
+// pass committed, the resize must draw with the window, rather than stretching
+// the last frame until another display tick. Ordinary windows keep #1044's guard.
+func TestPopoverResizeDrawsAfterCommittedFrame(t *testing.T) {
+	oldPass := caPass
+	caPass = 42
+	defer func() { caPass = oldPass }()
+	for _, tc := range []struct {
+		name                                                      string
+		popover, resized, transaction, samePass, live, deferFrame bool
+	}{
+		{"popover-next-pass", true, true, true, false, false, false},
+		{"popover-same-pass", true, true, true, true, false, true},
+		{"popover-direct-present", true, true, false, true, false, false},
+		{"popover-duplicate-display", true, false, false, true, false, true},
+		{"popover-new-frame", true, false, false, false, false, false},
+		{"window-resize-after-transaction", false, true, true, false, false, true},
+		{"window-same-pass", false, true, true, true, false, true},
+		{"live-resize", true, true, true, true, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			w := &window{}
+			if tc.popover {
+				w.popover = 1
+			}
+			s := &surface{w: w, resized: tc.resized, framePass: 41}
+			if tc.samePass {
+				s.framePass = caPass
+			}
+			if got := s.deferDisplay(tc.live, tc.transaction); got != tc.deferFrame {
+				t.Fatalf("defer resize = %v, want %v", got, tc.deferFrame)
+			}
+		})
+	}
+}
