+// deferDisplay keeps AppKit from drawing a frame before the last transaction
+// has committed. Called by updateLayer, before sending a SurfaceFrame.
+func (s *surface) deferDisplay(liveResize, transaction bool) bool {
+	if liveResize || s.w.popover != 0 && s.framePass != caPass {
+		// Popovers resize continuously with the app's springs. After the old
+		// pass committed, draw at the new size before AppKit commits this one;
+		// deferring every resize alternates stretched and correctly sized frames.
+		return false
+	}
+	return s.resized && transaction || !s.resized && s.framePass == caPass
 }
 
