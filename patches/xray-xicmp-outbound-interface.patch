diff --git a/proxy/tun/bind_socket_darwin.go b/proxy/tun/bind_socket_darwin.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/bind_socket_darwin.go
@@ -0,0 +1,46 @@
+//go:build darwin
+
+package tun
+
+import (
+	"fmt"
+	"net"
+	"net/netip"
+
+	"golang.org/x/sys/unix"
+)
+
+func socketRouteFamily(network, address string) (int, error) {
+	if peer, err := netip.ParseAddrPort(address); err == nil {
+		if peer.Addr().Unmap().Is4() {
+			return unix.AF_INET, nil
+		}
+		return unix.AF_INET6, nil
+	}
+	switch network {
+	case "tcp4", "udp4", "ip4":
+		return unix.AF_INET, nil
+	case "tcp6", "udp6", "ip6":
+		return unix.AF_INET6, nil
+	default:
+		return 0, fmt.Errorf("unsupported socket network %q", network)
+	}
+}
+
+func (updater *InterfaceUpdater) socketInterface(network, address string) (*net.Interface, bool, error) {
+	family, err := socketRouteFamily(network, address)
+	if err != nil {
+		return nil, false, err
+	}
+	updater.Lock()
+	index, name := updater.tunIndex, updater.fixedName
+	updater.Unlock()
+	peer, _ := netip.ParseAddrPort(address)
+	iface, err := findDarwinOutboundInterface(index, name, family, peer.Addr())
+	local := err == nil && darwinPeerIsLocal(iface, name, peer.Addr())
+	return iface, local, err
+}
+
+func darwinPeerIsLocal(iface *net.Interface, fixedName string, peer netip.Addr) bool {
+	return iface != nil && fixedName == "" && peer.IsValid() && iface.Flags&net.FlagLoopback != 0
+}
diff --git a/proxy/tun/bind_socket_darwin_test.go b/proxy/tun/bind_socket_darwin_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/tun/bind_socket_darwin_test.go
@@ -0,0 +1,142 @@
+//go:build darwin
+
+package tun
+
+import (
+	"net"
+	"net/netip"
+	"strings"
+	"testing"
+
+	"golang.org/x/net/route"
+	"golang.org/x/sys/unix"
+)
+
+func defaultTestRoute(family, index int) route.Message {
+	addrs := make([]route.Addr, unix.RTAX_MAX)
+	if family == unix.AF_INET {
+		addrs[unix.RTAX_DST] = &route.Inet4Addr{}
+		addrs[unix.RTAX_NETMASK] = &route.Inet4Addr{}
+	} else {
+		addrs[unix.RTAX_DST] = &route.Inet6Addr{}
+		addrs[unix.RTAX_NETMASK] = &route.Inet6Addr{}
+	}
+	return &route.RouteMessage{Index: index, Flags: unix.RTF_UP | unix.RTF_GATEWAY, Addrs: addrs}
+}
+
+func TestSocketRoutesMatchAddressFamily(t *testing.T) {
+	for _, shared := range []bool{false, true} {
+		v6 := 12
+		if shared {
+			v6 = 11
+		}
+		routes := []route.Message{defaultTestRoute(unix.AF_INET, 99), defaultTestRoute(unix.AF_INET, 11), defaultTestRoute(unix.AF_INET6, v6)}
+		for _, tc := range []struct{ family, want int }{{unix.AF_INET, 11}, {unix.AF_INET6, v6}, {unix.AF_UNSPEC, 11}} {
+			got, err := selectDarwinOutboundRoute(routes, 99, tc.family)
+			if err != nil || got != tc.want {
+				t.Fatalf("shared=%v family=%d got=%d err=%v want=%d", shared, tc.family, got, err, tc.want)
+			}
+		}
+	}
+	if _, err := selectDarwinOutboundRoute([]route.Message{defaultTestRoute(unix.AF_INET, 11)}, 0, unix.AF_INET6); err == nil {
+		t.Fatal("IPv6 must not fall back to IPv4")
+	}
+}
+
+func TestSocketFamilyUsesPeerForDualStackSockets(t *testing.T) {
+	for _, tc := range []struct {
+		network, address string
+		want             int
+	}{
+		{"tcp4", "192.0.2.1:80", unix.AF_INET},
+		{"tcp6", "[2001:db8::1]:80", unix.AF_INET6},
+		{"udp6", "[::ffff:192.0.2.1]:53", unix.AF_INET},
+		{"ip6", "example.invalid:0", unix.AF_INET6},
+	} {
+		got, err := socketRouteFamily(tc.network, tc.address)
+		if err != nil || got != tc.want {
+			t.Fatalf("%s %s: got %d %v want %d", tc.network, tc.address, got, err, tc.want)
+		}
+	}
+}
+
+func TestRemoteSocketStillRequiresInterface(t *testing.T) {
+	updater := &InterfaceUpdater{fixedName: "masir-no-such-interface-for-test"}
+	err := updater.BindSocket("tcp4", "192.0.2.1:80", nil)
+	if err == nil || !strings.Contains(err.Error(), "iface not found") {
+		t.Fatalf("expected missing-interface error, got %v", err)
+	}
+}
+
+func connectedTestRoute(prefix string, index int) route.Message {
+	p := netip.MustParsePrefix(prefix)
+	addrs := make([]route.Addr, unix.RTAX_MAX)
+	if p.Addr().Is4() {
+		var mask [4]byte
+		copy(mask[:], net.CIDRMask(p.Bits(), 32))
+		addrs[unix.RTAX_DST] = &route.Inet4Addr{IP: p.Addr().As4()}
+		addrs[unix.RTAX_NETMASK] = &route.Inet4Addr{IP: mask}
+	} else {
+		var mask [16]byte
+		copy(mask[:], net.CIDRMask(p.Bits(), 128))
+		addrs[unix.RTAX_DST] = &route.Inet6Addr{IP: p.Addr().As16()}
+		addrs[unix.RTAX_NETMASK] = &route.Inet6Addr{IP: mask}
+	}
+	return &route.RouteMessage{Index: index, Flags: unix.RTF_UP, Addrs: addrs}
+}
+
+func TestConnectedIPv6PeerNeedsNoDefaultRoute(t *testing.T) {
+	routes := []route.Message{defaultTestRoute(unix.AF_INET, 11), connectedTestRoute("fd00:1::/64", 12), connectedTestRoute("::/1", 99), connectedTestRoute("8000::/1", 99)}
+	index, err := selectDarwinPeerRoute(routes, map[int]bool{99: true}, unix.AF_INET6, netip.MustParseAddr("fd00:1::2"))
+	if err != nil || index != 12 {
+		t.Fatalf("connected IPv6 peer: index=%d err=%v, want 12", index, err)
+	}
+	if _, err := selectDarwinPeerRoute(routes, map[int]bool{99: true}, unix.AF_INET6, netip.MustParseAddr("2001:db8::2")); err == nil {
+		t.Fatal("off-link IPv6 peer needs a matching route")
+	}
+	routes = append(routes, defaultTestRoute(unix.AF_INET6, 13))
+	index, err = selectDarwinPeerRoute(routes, map[int]bool{99: true}, unix.AF_INET6, netip.MustParseAddr("2001:db8::2"))
+	if err != nil || index != 13 {
+		t.Fatalf("off-link peer: index=%d err=%v, want 13", index, err)
+	}
+}
+
+func TestPeerRoutesPreferHostRoutesAndKeepRejects(t *testing.T) {
+	peer := netip.MustParseAddr("192.0.2.3")
+	host := connectedTestRoute("192.0.2.3/32", 17).(*route.RouteMessage)
+	host.Flags |= unix.RTF_HOST
+	host.Addrs[unix.RTAX_NETMASK] = nil
+	routes := []route.Message{defaultTestRoute(unix.AF_INET, 11), host}
+	index, err := selectDarwinPeerRoute(routes, nil, unix.AF_INET, peer)
+	if err != nil || index != 17 {
+		t.Fatalf("host route: %d %v", index, err)
+	}
+	index, err = selectDarwinPeerRoute(routes, map[int]bool{17: true}, unix.AF_INET, peer)
+	if err != nil || index != 11 {
+		t.Fatalf("excluded route: %d %v", index, err)
+	}
+	host.Flags |= unix.RTF_REJECT
+	if _, err := selectDarwinPeerRoute(routes, nil, unix.AF_INET, peer); err == nil {
+		t.Fatal("reject route must not fall back to a default")
+	}
+}
+
+func TestOwnAddressLoopbackRouteBypassesBinding(t *testing.T) {
+	peer := netip.MustParseAddr("192.0.2.3")
+	routes := []route.Message{defaultTestRoute(unix.AF_INET, 11), connectedTestRoute("192.0.2.3/32", 1)}
+	index, err := selectDarwinPeerRoute(routes, nil, unix.AF_INET, peer)
+	if err != nil || index != 1 {
+		t.Fatalf("host route: %d %v", index, err)
+	}
+	local := &net.Interface{Index: index, Name: "lo0", Flags: net.FlagUp | net.FlagLoopback}
+	iface, err := validateDarwinRouteInterface(local, true)
+	if err != nil || !darwinPeerIsLocal(iface, "", peer) {
+		t.Fatalf("local peer must bypass binding: %v", err)
+	}
+	if darwinPeerIsLocal(iface, "lo0", peer) {
+		t.Fatal("explicit interface must retain forced binding")
+	}
+	if _, err := validateDarwinRouteInterface(local, false); err == nil {
+		t.Fatal("loopback must not become a default egress")
+	}
+}
