+
+func withControllers(t *testing.T, controllers ...func(string, string, syscall.RawConn) error) {
+	t.Helper()
+	internet.ControllersLock.Lock()
+	old := internet.Controllers
+	internet.Controllers = controllers
+	internet.ControllersLock.Unlock()
+	t.Cleanup(func() {
+		internet.ControllersLock.Lock()
+		internet.Controllers = old
+		internet.ControllersLock.Unlock()
+	})
+}
+
+func requireICMPSockets(t *testing.T) {
+	t.Helper()
+	for _, tc := range []struct{ network, address string }{{"udp4", "0.0.0.0"}, {"udp6", "::"}} {
+		socket, err := icmp.ListenPacket(tc.network, tc.address)
+		if err == nil {
+			socket.Close()
+			continue
+		}
+		unsupported := errors.Is(err, syscall.EPERM) || errors.Is(err, syscall.EACCES) || errors.Is(err, syscall.EAFNOSUPPORT) || errors.Is(err, syscall.EPROTONOSUPPORT) || errors.Is(err, syscall.ESOCKTNOSUPPORT)
+		if unsupported && os.Getenv("XRAY_REQUIRE_ICMP") != "1" {
+			t.Skipf("ICMP datagram sockets unavailable: %v", err)
+		}
+		t.Fatal(err)
+	}
+}
+
+func TestICMPPeerBindingsAreIndependent(t *testing.T) {
+	requireICMPSockets(t)
+	var got []string
+	withControllers(t, func(network, address string, raw syscall.RawConn) error {
+		got = append(got, network+" "+address)
+		return nil
+	})
+	p, err := NewConnClient(&Config{DGRAM: true, IPs: []string{"192.0.2.1", "198.51.100.2", "127.0.0.1", "::1"}}, &net.Destination{Address: net.LocalHostIP, Port: 1234, Network: net.Network_UDP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	c := p.(*xicmpConnClient)
+	if len(got) != 0 {
+		t.Fatal("unused peers opened sockets")
+	}
+	var sockets []*icmpPeerSocket
+	for _, ip := range []string{"192.0.2.1", "198.51.100.2", "127.0.0.1", "::1"} {
+		socket, err := c.socketForPeer(net.ParseIP(ip))
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, old := range sockets {
+			if socket.conn == old.conn || socket.id == old.id {
+				t.Fatal("peers shared a socket or raw ID")
+			}
+		}
+		sockets = append(sockets, socket)
+	}
+	if len(got) != 4 || got[0] != "udp4 192.0.2.1:1234" || got[1] != "udp4 198.51.100.2:1234" || got[2] != "udp4 127.0.0.1:1234" || got[3] != "udp6 [::1]:1234" {
+		t.Fatalf("wrong peer bindings: %v", got)
+	}
+	reused, err := c.socketForPeer(net.ParseIP("192.0.2.1"))
+	if err != nil || reused != sockets[0] {
+		t.Fatal("peer socket was not reused")
+	}
+}
+
+func TestICMPControllerFailureClosesSocket(t *testing.T) {
+	requireICMPSockets(t)
+	rejected := errors.New("interface unavailable")
+	var raw syscall.RawConn
+	withControllers(t, func(network, address string, c syscall.RawConn) error { raw = c; return rejected })
+	socket, err := listenControlledICMP("udp4", "0.0.0.0", "127.0.0.1:1234")
+	if !errors.Is(err, rejected) || socket != nil {
+		t.Fatalf("expected controller rejection, got %v", err)
+	}
+	if raw == nil {
+		t.Fatal("controller not called")
+	}
+	if err := raw.Control(func(uintptr) {}); err == nil {
+		t.Fatal("rejected socket remained open")
+	}
+}
