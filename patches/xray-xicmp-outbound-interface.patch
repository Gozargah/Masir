+func TestSinglePeerSetupErrorAndRefreshFallback(t *testing.T) {
+	requireICMPSockets(t)
+	rejected := errors.New("socket unavailable")
+	fail := true
+	withControllers(t, func(string, string, syscall.RawConn) error {
+		if fail {
+			return rejected
+		}
+		return nil
+	})
+	cfg := &Config{DGRAM: true}
+	dest := &net.Destination{Address: net.LocalHostIP}
+	if conn, err := NewConnClient(cfg, dest); conn != nil || !errors.Is(err, rejected) {
+		t.Fatalf("dial error: %v", err)
+	}
+	fail = false
+	conn, err := NewConnClient(cfg, dest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	c := conn.(*xicmpConnClient)
+	old := c.peers[c.ip]
+	old.refreshAt = time.Time{}
+	fail = true
+	got, err := c.socketForPeer(c.ip)
+	if err != nil || got != old {
+		t.Fatalf("working socket lost on refresh: %v", err)
+	}
+	c.mu.Lock()
+	c.retire(old)
+	c.mu.Unlock()
+	if got, err := c.socketForPeer(c.ip); got != nil || !errors.Is(err, rejected) {
+		t.Fatalf("retired socket reused: %v", err)
+	}
+}
