+// ICMP opens its sockets outside the system dialer. Apply the same controllers
+// so transports such as TUN can bind these sockets to the outbound interface.
+func listenControlledICMP(network, address, destination string) (*icmp.PacketConn, error) {
+	conn, err := icmp.ListenPacket(network, address)
+	if err != nil {
+		return nil, err
+	}
+	var underlying net.PacketConn
+	if p := conn.IPv4PacketConn(); p != nil {
+		underlying = p.PacketConn
+	} else {
+		underlying = conn.IPv6PacketConn().PacketConn
+	}
+	sc, ok := underlying.(syscall.Conn)
+	if !ok {
+		conn.Close()
+		return nil, fmt.Errorf("ICMP socket does not expose syscall connection")
+	}
+	raw, err := sc.SyscallConn()
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	internet.ControllersLock.Lock()
+	controllers := append([]func(string, string, syscall.RawConn) error(nil), internet.Controllers...)
+	internet.ControllersLock.Unlock()
+	for _, control := range controllers {
+		if err := control(strings.SplitN(network, ":", 2)[0], destination, raw); err != nil {
+			conn.Close()
+			return nil, err
+		}
+	}
+	return conn, nil
+}
+
+// Remote and loopback peers need separate sockets: binding a shared socket to
+// the outbound interface would also force local packets onto that interface.
+type icmpPeerGroup struct{ remote, local netip.Addr }
+
+func groupICMPPeers(peers []netip.Addr) [2]icmpPeerGroup {
+	var groups [2]icmpPeerGroup
+	for _, peer := range peers {
+		peer = peer.Unmap()
+		family := 1
+		if peer.Is4() {
+			family = 0
+		}
+		if peer.IsLoopback() {
+			groups[family].local = peer
+		} else {
+			groups[family].remote = peer
+		}
+	}
+	return groups
+}
+
+func listenICMPPeers(network, address string, peers icmpPeerGroup, port string) (*icmp.PacketConn, *icmp.PacketConn, error) {
+	primary := peers.remote
+	if !primary.IsValid() {
+		primary = peers.local
+	}
+	if !primary.IsValid() {
+		return nil, nil, nil
+	}
+	socket, err := listenControlledICMP(network, address, net.JoinHostPort(primary.String(), port))
+	if err != nil {
+		return nil, nil, err
+	}
+	if !peers.remote.IsValid() || !peers.local.IsValid() {
+		return socket, nil, nil
+	}
+	local, err := listenControlledICMP(network, address, net.JoinHostPort(peers.local.String(), port))
+	if err != nil {
+		socket.Close()
+		return nil, nil, err
+	}
+	return socket, local, nil
+}
+
+func (c *xicmpConnClient) sockets() [4]*icmp.PacketConn {
+	return [4]*icmp.PacketConn{c.icmp4, c.icmp6, c.loop4, c.loop6}
+}
+func (c *xicmpConnClient) packetConn(ip net.IP) *icmp.PacketConn {
+	if ip.To4() != nil {
+		if ip.IsLoopback() && c.loop4 != nil {
+			return c.loop4
+		}
+		return c.icmp4
+	}
+	if ip.IsLoopback() && c.loop6 != nil {
+		return c.loop6
+	}
+	return c.icmp6
+}
+func (c *xicmpConnClient) socketID(socket *icmp.PacketConn) int {
+	if socket == c.loop4 || socket == c.loop6 {
+		return c.localID
+	}
+	return c.id
+}
