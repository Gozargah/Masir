+func TestICMPUnusedFamilyIsNotOpened(t *testing.T) {
+	requireICMPSockets(t)
+	var networks []string
+	withControllers(t, func(network, address string, raw syscall.RawConn) error {
+		networks = append(networks, network)
+		return nil
+	})
+	p, err := NewConnClient(&Config{DGRAM: true}, &net.Destination{Address: net.LocalHostIP, Network: net.Network_UDP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	c := p.(*xicmpConnClient)
+	if c.icmp6 != nil || len(networks) != 1 || networks[0] != "udp4" {
+		t.Fatalf("opened unused family: %v", networks)
+	}
+}
