+func TestICMPControllerFailureClosesSocket(t *testing.T) {
+	requireICMPSockets(t)
+	rejected := errors.New("interface unavailable")
+	var raw syscall.RawConn
+	withControllers(t, func(network, address string, c syscall.RawConn) error { raw = c; return rejected })
+	socket, err := listenControlledICMP("udp4", "0.0.0.0", "127.0.0.1:1234")
+	if !errors.Is(err, rejected) || socket != nil {
+		t.Fatalf("expected controller rejection, got %v", err)
+	}
+	if raw == nil {
+		t.Fatal("controller not called")
+	}
+	if err := raw.Control(func(uintptr) {}); err == nil {
+		t.Fatal("rejected socket remained open")
+	}
+}
