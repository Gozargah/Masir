+func TestRawIDsRemainReservedUntilSocketCloses(t *testing.T) {
+	requireICMPSockets(t)
+	conn, err := icmp.ListenPacket("udp4", "0.0.0.0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	c := &xicmpConnClient{nextID: 65535, rawIDs: map[int]bool{0: true}}
+	old := &icmpPeerSocket{conn: conn, id: c.reserveRawID(), done: make(chan struct{})}
+	if old.id != 65535 || c.reserveRawID() != 1 {
+		t.Fatal("allocator did not wrap past live IDs")
+	}
+	c.nextID = old.id
+	if c.reserveRawID() == old.id {
+		t.Fatal("reused ID of a socket still open")
+	}
+	c.closeSocket(old)
+	c.nextID = old.id
+	if c.reserveRawID() != old.id {
+		t.Fatal("closed socket's ID was not reusable")
+	}
+}
