+// ICMP opens its sockets outside the system dialer. Apply the same controllers
+// so transports such as TUN can bind these sockets to the outbound interface.
+func listenControlledICMP(network, address, destination string) (*icmp.PacketConn, error) {
+	conn, err := icmp.ListenPacket(network, address)
+	if err != nil {
+		return nil, err
+	}
+	var underlying net.PacketConn
+	if p := conn.IPv4PacketConn(); p != nil {
+		underlying = p.PacketConn
+	} else {
+		underlying = conn.IPv6PacketConn().PacketConn
+	}
+	sc, ok := underlying.(syscall.Conn)
+	if !ok {
+		conn.Close()
+		return nil, fmt.Errorf("ICMP socket does not expose syscall connection")
+	}
+	raw, err := sc.SyscallConn()
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	internet.ControllersLock.Lock()
+	controllers := append([]func(string, string, syscall.RawConn) error(nil), internet.Controllers...)
+	internet.ControllersLock.Unlock()
+	for _, control := range controllers {
+		if err := control(strings.SplitN(network, ":", 2)[0], destination, raw); err != nil {
+			conn.Close()
+			return nil, err
+		}
+	}
+	return conn, nil
+}
