+func TestFailedWriteRefreshesPeerBinding(t *testing.T) {
+	requireICMPSockets(t)
+	calls := 0
+	withControllers(t, func(string, string, syscall.RawConn) error { calls++; return nil })
+	p, err := NewConnClient(&Config{DGRAM: true}, &net.Destination{Address: net.LocalHostIP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	c := p.(*xicmpConnClient)
+	first, err := c.socketForPeer(c.ip)
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.SetWriteDeadline(time.Now().Add(-time.Second))
+	if _, err := p.WriteTo([]byte("test"), nil); !errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatalf("write: %v", err)
+	}
+	p.SetWriteDeadline(time.Time{})
+	fresh, err := c.socketForPeer(c.ip)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if fresh == first || fresh.id != first.id || calls != 2 {
+		t.Fatal("failed write did not refresh its peer binding")
+	}
+}
