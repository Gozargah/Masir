+// Open on first use: large alternative-IP lists do not allocate unused sockets.
+// Each peer retains its binding and raw ICMP ID for the connection's lifetime.
+func (c *xicmpConnClient) socketForPeer(ip net.IP) (*icmpPeerSocket, error) {
+	peer, ok := netip.AddrFromSlice(ip)
+	if !ok {
+		return nil, fmt.Errorf("invalid ICMP peer")
+	}
+	peer = peer.Unmap()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.closed() {
+		return nil, io.ErrClosedPipe
+	}
+	if socket := c.peers[peer]; socket != nil {
+		return socket, nil
+	}
+	if !c.udp && len(c.peers) >= 65536 {
+		return nil, fmt.Errorf("raw ICMP peer ID space exhausted")
+	}
+	network, address := "ip6:ipv6-icmp", "::"
+	if peer.Is4() {
+		network, address = "ip4:icmp", "0.0.0.0"
+	}
+	if c.udp {
+		network = "udp6"
+		if peer.Is4() {
+			network = "udp4"
+		}
+	}
+	conn, err := listenControlledICMP(network, address, net.JoinHostPort(peer.String(), c.port))
+	if err != nil {
+		return nil, err
+	}
+	if err = conn.SetReadDeadline(c.readDeadline); err == nil {
+		err = conn.SetWriteDeadline(c.writeDeadline)
+	}
+	if err != nil {
+		conn.Close()
+		return nil, err
+	}
+	socket := &icmpPeerSocket{conn: conn, id: c.nextID}
+	c.nextID = (c.nextID + 1) % 65536
+	c.peers[peer] = socket
+	c.wg.Add(1)
+	if peer.Is4() {
+		go c.recv4(socket)
+	} else {
+		go c.recv6(socket)
+	}
+	return socket, nil
 }

