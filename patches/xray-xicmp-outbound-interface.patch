+func TestRefreshDrainsAfterBorrowedWrites(t *testing.T) {
+	requireICMPSockets(t)
+	withControllers(t)
+	p, err := NewConnClient(&Config{DGRAM: true}, &net.Destination{Address: net.LocalHostIP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	c := p.(*xicmpConnClient)
+	c.mu.Lock()
+	old := c.peers[c.ip]
+	old.refreshAt = time.Time{}
+	old.writes++
+	fresh, err := c.socketForPeerLocked(c.ip)
+	alive := !old.closed() && c.draining[old] && old.drain == nil
+	old.writes--
+	c.drainWhenIdle(old)
+	started := old.drain != nil && !old.closed()
+	c.mu.Unlock()
+	if err != nil || fresh == old || !alive || !started {
+		t.Fatalf("refresh interrupted the previous socket: %v", err)
+	}
+	select {
+	case <-old.done:
+	case <-time.After(peerSocketDrain + time.Second):
+		t.Fatal("old socket did not finish draining")
+	}
+}
