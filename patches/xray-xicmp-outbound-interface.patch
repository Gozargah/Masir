+func TestICMPUsesConfiguredPeerFamilies(t *testing.T) {
+	requireICMPSockets(t)
+	var got []string
+	withControllers(t, func(network, address string, c syscall.RawConn) error {
+		got = append(got, network+" "+address)
+		return nil
+	})
+	conn, err := NewConnClient(&Config{DGRAM: true, IPs: []string{"192.0.2.1", "2001:db8::1"}}, &net.Destination{Address: net.LocalHostIP, Port: 1234, Network: net.Network_UDP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	if len(got) != 2 || got[0] != "udp4 192.0.2.1:1234" || got[1] != "udp6 [2001:db8::1]:1234" {
+		t.Fatalf("controllers saw %v; want configured IPv4/IPv6 peers", got)
+	}
+}
+
+func requireICMPSockets(t *testing.T) {
+	t.Helper()
+	for _, tc := range []struct{ network, address string }{{"udp4", "0.0.0.0"}, {"udp6", "::"}} {
+		socket, err := icmp.ListenPacket(tc.network, tc.address)
+		if err == nil {
+			socket.Close()
+			continue
+		}
+		unsupported := errors.Is(err, syscall.EPERM) || errors.Is(err, syscall.EACCES) || errors.Is(err, syscall.EAFNOSUPPORT) || errors.Is(err, syscall.EPROTONOSUPPORT) || errors.Is(err, syscall.ESOCKTNOSUPPORT)
+		if unsupported && os.Getenv("XRAY_REQUIRE_ICMP") != "1" {
+			t.Skipf("ICMP datagram sockets unavailable: %v", err)
+		}
+		t.Fatal(err)
+	}
+}
