+	"github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+)
+
+func withControllers(t *testing.T, controllers ...func(string, string, syscall.RawConn) error) {
+	t.Helper()
+	internet.ControllersLock.Lock()
+	old := internet.Controllers
+	internet.Controllers = controllers
+	internet.ControllersLock.Unlock()
+	t.Cleanup(func() {
+		internet.ControllersLock.Lock()
+		internet.Controllers = old
+		internet.ControllersLock.Unlock()
+	})
+}
+
+func TestICMPDialerControllers(t *testing.T) {
+	var networks []string
+	requireICMPSockets(t)
+	destination := net.Destination{Address: net.LocalHostIP, Port: 1234, Network: net.Network_UDP}
+	withControllers(t, func(network, address string, c syscall.RawConn) error {
+		want := destination.NetAddr()
+		if network == "udp6" {
+			want = "[::1]:1234"
+		}
+		if address != want {
+			t.Errorf("address = %q, want %q", address, want)
+		}
+		networks = append(networks, network)
+		return nil
+	})
+	c, err := NewConnClient(&Config{DGRAM: true, IPs: []string{"127.0.0.1", "::1"}}, &destination)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	if len(networks) != 2 || networks[0] != "udp4" || networks[1] != "udp6" {
+		t.Fatalf("controllers saw %v, want udp4 and udp6", networks)
+	}
+}
+
+func TestICMPControllerFailureClosesSocket(t *testing.T) {
+	requireICMPSockets(t)
+	rejected := errors.New("interface unavailable")
+	var socket syscall.RawConn
+	withControllers(t, func(network, address string, c syscall.RawConn) error {
+		socket = c
+		return rejected
+	})
+	c, err := listenControlledICMP("udp4", "0.0.0.0", "127.0.0.1:1234")
+	if !errors.Is(err, rejected) || c != nil {
+		t.Fatalf("got %v, %v; want nil and controller error", c, err)
+	}
+	if socket == nil {
+		t.Fatal("controller was not called")
+	}
+	if err := socket.Control(func(uintptr) {}); err == nil {
+		t.Fatal("rejected socket is still open")
+	}
+}
+
+func TestICMPPartialSetupClosesBothSockets(t *testing.T) {
+	requireICMPSockets(t)
+	var sockets []syscall.RawConn
+	withControllers(t, func(network, address string, c syscall.RawConn) error {
+		sockets = append(sockets, c)
+		if network == "udp6" {
+			return errors.New("IPv6 binding failed")
+		}
+		return nil
+	})
+	c, err := NewConnClient(&Config{DGRAM: true, IPs: []string{"127.0.0.1", "::1"}}, &net.Destination{Address: net.LocalHostIP, Network: net.Network_UDP})
+	if err == nil || c != nil {
+		t.Fatalf("got %v, %v; want failed setup", c, err)
+	}
+	if len(sockets) != 2 {
+		t.Fatalf("controllers saw %d sockets, want two", len(sockets))
+	}
+	for i, socket := range sockets {
+		if err := socket.Control(func(uintptr) {}); err == nil {
+			t.Errorf("socket %d is still open", i)
+		}
+	}
+}
