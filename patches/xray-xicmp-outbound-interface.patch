+//go:build darwin
+
+package tun
+
+import (
+	"golang.org/x/net/route"
+	"golang.org/x/sys/unix"
+	"strings"
+	"testing"
+)
+
+func defaultTestRoute(family, index int) route.Message {
+	addrs := make([]route.Addr, unix.RTAX_MAX)
+	if family == unix.AF_INET {
+		addrs[unix.RTAX_DST] = &route.Inet4Addr{}
+		addrs[unix.RTAX_NETMASK] = &route.Inet4Addr{}
+	} else {
+		addrs[unix.RTAX_DST] = &route.Inet6Addr{}
+		addrs[unix.RTAX_NETMASK] = &route.Inet6Addr{}
+	}
+	return &route.RouteMessage{Index: index, Flags: unix.RTF_UP | unix.RTF_GATEWAY, Addrs: addrs}
+}
+
+func TestSocketRoutesMatchAddressFamily(t *testing.T) {
+	for _, shared := range []bool{false, true} {
+		v6 := 12
+		if shared {
+			v6 = 11
+		}
+		routes := []route.Message{defaultTestRoute(unix.AF_INET, 99), defaultTestRoute(unix.AF_INET, 11), defaultTestRoute(unix.AF_INET6, v6)}
+		for _, tc := range []struct{ family, want int }{{unix.AF_INET, 11}, {unix.AF_INET6, v6}, {unix.AF_UNSPEC, 11}} {
+			got, err := selectDarwinOutboundRoute(routes, 99, tc.family)
+			if err != nil || got != tc.want {
+				t.Fatalf("shared=%v family=%d got=%d err=%v want=%d", shared, tc.family, got, err, tc.want)
+			}
+		}
+	}
+	if _, err := selectDarwinOutboundRoute([]route.Message{defaultTestRoute(unix.AF_INET, 11)}, 0, unix.AF_INET6); err == nil {
+		t.Fatal("IPv6 must not fall back to IPv4")
+	}
+}
+
+func TestSocketFamilyUsesPeerForDualStackSockets(t *testing.T) {
+	for _, tc := range []struct {
+		network, address string
+		want             int
+	}{
+		{"tcp4", "192.0.2.1:80", unix.AF_INET},
+		{"tcp6", "[2001:db8::1]:80", unix.AF_INET6},
+		{"udp6", "[::ffff:192.0.2.1]:53", unix.AF_INET},
+		{"ip6", "example.invalid:0", unix.AF_INET6},
+	} {
+		got, err := socketRouteFamily(tc.network, tc.address)
+		if err != nil || got != tc.want {
+			t.Fatalf("%s %s: got %d %v want %d", tc.network, tc.address, got, err, tc.want)
+		}
+	}
+}
+
+func TestRemoteSocketStillRequiresInterface(t *testing.T) {
+	updater := &InterfaceUpdater{fixedName: "masir-no-such-interface-for-test"}
+	err := updater.BindSocket("tcp4", "192.0.2.1:80", nil)
+	if err == nil || !strings.Contains(err.Error(), "iface not found") {
+		t.Fatalf("expected missing-interface error, got %v", err)
+	}
+}
