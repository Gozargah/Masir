+func TestReadDeadlineBeforeFirstWrite(t *testing.T) {
+	p, err := NewConnClient(&Config{DGRAM: true, IPs: []string{"127.0.0.1", "::1"}}, &net.Destination{Address: net.LocalHostIP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	result := make(chan error, 1)
+	go func() { _, _, err := p.ReadFrom(nil); result <- err }()
+	p.SetReadDeadline(time.Now().Add(10 * time.Millisecond))
+	select {
+	case err := <-result:
+		if !errors.Is(err, os.ErrDeadlineExceeded) {
+			t.Fatalf("read deadline: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("read blocked without a socket")
+	}
+	p.Close()
+	if _, _, err := p.ReadFrom(nil); !errors.Is(err, io.EOF) {
+		t.Fatalf("closed read: %v", err)
+	}
+}
+func TestPeerSocketRefreshAndZones(t *testing.T) {
+	requireICMPSockets(t)
+	var got []string
+	withControllers(t, func(_, address string, _ syscall.RawConn) error { got = append(got, address); return nil })
+	p, err := NewConnClient(&Config{DGRAM: true, IPs: []string{"fe80::2%test0", "fe80::2%test1"}}, &net.Destination{Address: net.LocalHostIP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	c := p.(*xicmpConnClient)
+	first, err := c.socketForPeer(c.ips[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := c.socketForPeer(c.ips[1])
+	if err != nil {
+		t.Fatal(err)
+	}
+	first.refreshAt = time.Time{}
+	fresh, err := c.socketForPeer(c.ips[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first == second || first == fresh || first.id != fresh.id {
+		t.Fatal("peer bindings or refresh incorrect")
+	}
+	if len(got) != 3 || got[0] != "[fe80::2%test0]:0" || got[1] != "[fe80::2%test1]:0" || got[2] != got[0] {
+		t.Fatalf("wrong scoped controller destinations: %v", got)
+	}
+}
