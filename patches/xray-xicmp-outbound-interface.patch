+func TestICMPPeerFailureKeepsExistingSocketAndCloseReapsAll(t *testing.T) {
+	requireICMPSockets(t)
+	withControllers(t, func(network, address string, raw syscall.RawConn) error {
+		if address == "198.51.100.2:1234" {
+			return errors.New("rejected peer")
+		}
+		return nil
+	})
+	p, err := NewConnClient(&Config{DGRAM: true, IPs: []string{"192.0.2.1", "198.51.100.2"}}, &net.Destination{Address: net.LocalHostIP, Port: 1234, Network: net.Network_UDP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	c := p.(*xicmpConnClient)
+	first, err := c.socketForPeer(netip.MustParseAddr("192.0.2.1"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.socketForPeer(netip.MustParseAddr("198.51.100.2")); err == nil {
+		t.Fatal("rejected peer succeeded")
+	}
+	if len(c.peers) != 1 {
+		t.Fatal("failed peer entered cache")
+	}
+	raw, err := first.conn.IPv4PacketConn().PacketConn.(syscall.Conn).SyscallConn()
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.Close()
+	if err := raw.Control(func(uintptr) {}); err == nil {
+		t.Fatal("close left peer socket open")
+	}
+	if _, err := c.socketForPeer(netip.MustParseAddr("192.0.2.1")); err == nil {
+		t.Fatal("closed connection reopened a socket")
+	}
+}
