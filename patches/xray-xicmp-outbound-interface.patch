+// BindSocket binds non-loopback sockets to their outbound interface. Darwin
+// refreshes the route for the peer's address family without requiring a TUN.
+func (updater *InterfaceUpdater) BindSocket(network, address string, c syscall.RawConn) error {
+	addrPort, _ := netip.ParseAddrPort(address)
+	if addrPort.Addr().Unmap().IsLoopback() || strings.HasPrefix(strings.ToLower(address), "localhost:") {
+		return nil
+	}
+	iface, err := updater.socketInterface(network, address)
+	if err != nil {
+		return errors.New("iface not found").Base(err)
+	}
+	if iface == nil {
+		return errors.New("iface not found")
+	}
+	var sockErr error
+	err = c.Control(func(fd uintptr) { sockErr = setinterface(network, address, fd, iface) })
+	if sockErr != nil {
+		return errors.New("failed to bind outbound interface").Base(sockErr)
+	}
+	return err
+}
