+//go:build linux && !android
+
+package tun
+
+import (
+	"fmt"
+	"net"
+	"testing"
+
+	"github.com/vishvananda/netlink"
+)
+
+func TestLinuxSocketFamilyUsesPeer(t *testing.T) {
+	for _, tc := range []struct {
+		network, address string
+		want             int
+	}{
+		{"udp4", "192.0.2.1:80", netlink.FAMILY_V4},
+		{"udp6", "[2001:db8::1]:80", netlink.FAMILY_V6},
+		{"udp6", "[::ffff:192.0.2.1]:53", netlink.FAMILY_V4},
+		{"ip6", "example.invalid:0", netlink.FAMILY_V6},
+	} {
+		if got := linuxSocketFamily(tc.network, tc.address); got != tc.want {
+			t.Errorf("%s %s: got family %d, want %d", tc.network, tc.address, got, tc.want)
+		}
+	}
+}
+
+func TestLinuxScopedPeerOverridesAutomaticInterface(t *testing.T) {
+	scoped, err := net.InterfaceByName("lo")
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Use a different interface as the automatic selection. The named or
+	// numeric zone must win regardless of the system's default routes.
+	automatic := &net.Interface{Index: scoped.Index + 1, Name: "other-egress"}
+	updater := &InterfaceUpdater{iface: automatic}
+	for _, zone := range []string{scoped.Name, fmt.Sprint(scoped.Index)} {
+		address := "[fe80::2%" + zone + "]:0"
+		got, _, err := updater.socketInterface("udp6", address)
+		if err != nil || got == nil || got.Index != scoped.Index {
+			t.Fatalf("zone %s selected %v, error %v", zone, got, err)
+		}
+		updater.tunIndex = scoped.Index
+		if _, _, err := updater.socketInterface("udp6", address); err == nil {
+			t.Fatal("accepted the excluded TUN as a peer zone")
+		}
+		updater.tunIndex = 0
+		updater.fixedName = automatic.Name
+		if got, _, err := updater.socketInterface("udp6", address); err != nil || got != automatic {
+			t.Fatalf("fixed interface changed: %v %v", got, err)
+		}
+		updater.fixedName = ""
+	}
+}
