+func TestICMPMixedLoopbackPeersUseSeparateSockets(t *testing.T) {
+	requireICMPSockets(t)
+	var got []string
+	withControllers(t, func(network, address string, raw syscall.RawConn) error {
+		got = append(got, network+" "+address)
+		return nil
+	})
+	p, err := NewConnClient(&Config{DGRAM: true, IPs: []string{"127.0.0.1", "192.0.2.1", "::1", "2001:db8::1"}}, &net.Destination{Address: net.LocalHostIP, Port: 1234, Network: net.Network_UDP})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer p.Close()
+	c := p.(*xicmpConnClient)
+	if len(got) != 4 {
+		t.Fatalf("expected four peer-specific sockets; saw %v", got)
+	}
+	for _, tc := range []struct {
+		ip   string
+		want *icmp.PacketConn
+	}{{"127.0.0.1", c.loop4}, {"192.0.2.1", c.icmp4}, {"::1", c.loop6}, {"2001:db8::1", c.icmp6}} {
+		if tc.want == nil || c.packetConn(net.ParseIP(tc.ip)) != tc.want {
+			t.Errorf("wrong socket for %s", tc.ip)
+		}
+	}
+	if c.loop4 == c.icmp4 || c.loop6 == c.icmp6 || c.socketID(c.loop4) == c.socketID(c.icmp4) {
+		t.Fatal("local and remote sockets must be isolated, including raw ICMP IDs")
+	}
+}
