+
+// Pick the longest matching non-TUN route. Connected routes are valid egress
+// routes even when that address family has no default gateway.
+func selectDarwinPeerRoute(messages []route.Message, excluded map[int]bool, family int, peer netip.Addr) (int, error) {
+	peer = peer.Unmap().WithZone("")
+	best, index, blocked := -1, 0, false
+	for _, message := range messages {
+		r, ok := message.(*route.RouteMessage)
+		if !ok || r.Index <= 0 || excluded[r.Index] || r.Flags&unix.RTF_UP == 0 {
+			continue
+		}
+		prefix, ok := darwinRoutePrefix(r)
+		if !ok || (family == unix.AF_INET && !prefix.Addr().Is4()) || (family == unix.AF_INET6 && !prefix.Addr().Is6()) || !prefix.Contains(peer) {
+			continue
+		}
+		if prefix.Bits() > best {
+			best, index = prefix.Bits(), r.Index
+			blocked = r.Flags&(unix.RTF_REJECT|unix.RTF_BLACKHOLE) != 0
+		}
+	}
+	if blocked {
+		return 0, errors.New("peer route rejects traffic")
+	}
+	if index == 0 {
+		return 0, errors.New("peer route not found")
+	}
+	return index, nil
+}
+
+func darwinRoutePrefix(r *route.RouteMessage) (netip.Prefix, bool) {
+	if len(r.Addrs) <= unix.RTAX_DST {
+		return netip.Prefix{}, false
+	}
+	var address netip.Addr
+	var mask net.IPMask
+	switch dst := r.Addrs[unix.RTAX_DST].(type) {
+	case *route.Inet4Addr:
+		address = netip.AddrFrom4(dst.IP)
+		if len(r.Addrs) > unix.RTAX_NETMASK {
+			if m, ok := r.Addrs[unix.RTAX_NETMASK].(*route.Inet4Addr); ok {
+				mask = net.IPMask(m.IP[:])
+			}
+		}
+	case *route.Inet6Addr:
+		address = netip.AddrFrom16(dst.IP)
+		if len(r.Addrs) > unix.RTAX_NETMASK {
+			if m, ok := r.Addrs[unix.RTAX_NETMASK].(*route.Inet6Addr); ok {
+				mask = net.IPMask(m.IP[:])
+			}
+		}
+	default:
+		return netip.Prefix{}, false
+	}
+	if r.Flags&unix.RTF_HOST != 0 {
+		return netip.PrefixFrom(address, address.BitLen()), true
+	}
+	ones, bits := mask.Size()
+	if bits != address.BitLen() {
+		return netip.Prefix{}, false
+	}
+	return netip.PrefixFrom(address, ones).Masked(), true
+}
