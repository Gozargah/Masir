+// prepareResources runs a build-time finalizer after nested executable signing and
+// before bundle sealing, packages and updater archives. The executable comes from
+// the trusted build environment, never an update feed.
+func prepareResources(c *Config, dir, goos, goarch string) error {
+	tool := os.Getenv("MYGO_PREPARE_RESOURCES")
+	if tool == "" {
+		return nil
+	}
+	cmd := exec.Command(tool, dir, c.Version, goos, goarch)
+	if out, err := cmd.CombinedOutput(); err != nil {
+		return fmt.Errorf("prepare resources: %v: %s", err, out)
+	}
+	return nil
+}
