# Maintainer: Gozargah <https://github.com/Gozargah>
pkgname=masir-bin
pkgver=0.1.2
pkgrel=1
pkgdesc="A fast client for Xray: subscriptions, routing rules and a system-wide tunnel"
arch=('x86_64' 'aarch64')
url="https://github.com/Gozargah/Masir"
license=('AGPL-3.0-only')
depends=(
    'gtk3'
    'webkit2gtk-4.1'
    'libayatana-appindicator'
    'glibc'
    'hicolor-icon-theme'
)
optdepends=(
    'polkit: elevate privileges for TUN mode without sudo'
)
provides=('masir' 'masir-desktop')
conflicts=('masir' 'masir-desktop')
options=('!strip' '!debug')

source_x86_64=("${pkgname}-${pkgver}-amd64.deb::https://github.com/Gozargah/Masir/releases/download/v${pkgver}/masir-desktop-linux-${pkgver}-amd64.deb")
source_aarch64=("${pkgname}-${pkgver}-arm64.deb::https://github.com/Gozargah/Masir/releases/download/v${pkgver}/masir-desktop-linux-${pkgver}-arm64.deb")
sha256sums_x86_64=('3f7d33140038978b9137dd302a746f0d8df02e2480240190a367177c46c59a1f')
sha256sums_aarch64=('53dfe70a4a5c471aa89423a4a159d51c9295f51a730320e3c8413af8b25bca09')

package() {
    bsdtar -xf data.tar.gz -C "${pkgdir}"

    # Symlink binaries to /usr/bin
    install -dm755 "${pkgdir}/usr/bin"
    ln -s /opt/masir-desktop/masir-desktop "${pkgdir}/usr/bin/masir-desktop"
    ln -s /opt/masir-desktop/bin/masir "${pkgdir}/usr/bin/masir"

    # Pixmap fallback
    install -dm755 "${pkgdir}/usr/share/pixmaps"
    ln -s /usr/share/icons/hicolor/512x512/apps/masir-desktop.png "${pkgdir}/usr/share/pixmaps/masir-desktop.png"

    # Clean macOS metadata leftovers from deb package
    rm -f "${pkgdir}"/opt/masir-desktop/{AppIcon.rsrc,FinderInfo.bin}

    # License
    install -Dm644 "${pkgdir}/opt/masir-desktop/flags.LICENSE.txt" "${pkgdir}/usr/share/licenses/${pkgname}/flags.LICENSE.txt"
}
